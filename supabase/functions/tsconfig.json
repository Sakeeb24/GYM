{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "npm:@supabase/functions-js": ["./node_modules/@supabase/functions-js"],
      "npm:@supabase/functions-js/*": ["./node_modules/@supabase/functions-js/*"],
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"],
      "npm:@supabase/supabase-js@2/*": ["./node_modules/@supabase/supabase-js/*"],
      "npm:@supabase/auth-js@2": ["./node_modules/@supabase/auth-js"],
      "npm:@supabase/auth-js@2/*": ["./node_modules/@supabase/auth-js/*"]
    },
    "baseUrl": "."
  },
  "include": ["./**/*.ts"]
}
